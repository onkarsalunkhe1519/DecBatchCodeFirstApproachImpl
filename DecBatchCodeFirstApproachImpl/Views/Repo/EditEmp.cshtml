@model Employee

<form method="post">
    Name <input type="text" class="form-control" asp-for="Name" placeholder="Enter Name" /><br />

    Email<input type="text" class="form-control" asp-for="Email" placeholder="Enter Email" /><br />

    Salary<input type="text" class="form-control" asp-for="Salary" placeholder="Enter Salary" /><br />

    <input type="submit" class="btn btn-primary" value="Save" />
</form>