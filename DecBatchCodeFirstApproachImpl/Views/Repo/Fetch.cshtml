

@model List<Employee>



<br />
<a asp-controller="Emp" asp-action="AddEmp" class="btn btn-info">Add Emp</a>
<br />

<table class="table">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Salary</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <th scope="row">@d.Id</th>
                <td>@d.Name</td>
                <td>@d.Email</td>
                <td>@d.Salary</td>
                
            </tr>
        }


    </tbody>
</table>